<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compiles the pure-C# logic (Assets/_Project/Scripts/Logic) together with the EditMode tests
    outside of Unity so the rules can be validated with `dotnet test` in CI or without the Editor.
    The same test files run inside Unity through the Unity Test Framework.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>Starfall</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Assets\_Project\Scripts\Logic\**\*.cs" Link="Logic\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- UnityOnly tests use AssetDatabase and run exclusively inside the Editor -->
    <Compile Include="..\..\Assets\_Project\Tests\EditMode\**\*.cs" Exclude="..\..\Assets\_Project\Tests\EditMode\UnityOnly\**\*.cs" Link="Tests\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
